{
  "name": "auto-novel",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run dev:web",
    "dev:web": "vp run --filter \"@auto-novel/web^...\" build && vp run --parallel --filter \"@auto-novel/web...\" dev",
    "dev:admin": "vp run --filter @auto-novel/admin dev",
    "build": "vp run -r build",
    "typecheck": "vp run -r typecheck",
    "test": "vp run -r --filter '!@auto-novel/daemon' test",
    "test:unit": "vp run --filter @auto-novel/web --filter @auto-novel/admin --filter @auto-novel/translator test && vp run @auto-novel/crawler#test:unit",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "^22.22.1 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "pnpm@11.28.5"
}
