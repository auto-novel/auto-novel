{
  "name": "auto-novel",
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "build": "pnpm -r build",
    "build:daemon": "pnpm --filter \"@auto-novel/daemon...\" build",
    "build:web": "pnpm --filter \"@auto-novel/web...\" build",
    "predev:web": "pnpm --filter \"@auto-novel/web^...\" build",
    "dev:web": "pnpm --parallel --filter \"@auto-novel/web...\" dev"
  }
}
