{
  "name": "@auto-novel/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "browserslist": [
    "edge>=88",
    "firefox>=78",
    "chrome>=87",
    "safari>=14"
  ],
  "scripts": {
    "dev": "pnpm dev:remote",
    "dev:remote": "cross-env VITE_API_MODE=remote vite",
    "dev:local": "cross-env VITE_API_MODE=local vite",
    "dev:native": "cross-env VITE_API_MODE=native vite",
    "build": "vite build && vue-tsc -b --noEmit",
    "preview": "vite preview",
    "lint": "eslint src",
    "lint:dist": "eslint dist",
    "test": "vitest run",
    "prepare": "cd .. && husky web/.husky || true",
    "clean": "vue-tsc --build --clean"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^20.19.13",
    "@vue/eslint-config-typescript": "^14.6.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-compat": "^6.0.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-vue": "^10.4.0",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "prettier": "3.3.2",
    "pretty-quick": "^4.2.2",
    "proxy-agent": "^8.0.1",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@auto-novel/crawler": "workspace:*",
    "@auto-novel/translator": "workspace:*",
    "@img-comparison-slider/vue": "^8.0.0",
    "@novelia/auth-api": "github:auto-novel/auth#d9a39cee954527c3acd8354d2f5c044c15f21709&path:packages/auth-api",
    "@novelia/forum-api": "github:auto-novel/forum#24db0ee3309b93d4d5cf1ca88a5d8ef1bb2c8016&path:packages/forum-api",
    "@pinia/colada": "^1.2.0",
    "@types/lodash-es": "^4.17.12",
    "@types/opencc-js": "^1.0.3",
    "@types/uuid": "^10.0.0",
    "@vicons/material": "^0.12.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.8.1",
    "@vueuse/core": "^10.11.1",
    "@zip.js/zip.js": "^2.7.73",
    "crypto-es": "^2.1.0",
    "idb": "^8.0.3",
    "ky": "^2.1.0",
    "lodash-es": "^4.18.1",
    "naive-ui": "^2.44.1",
    "nanoid": "^5.1.5",
    "opencc-js": "^1.0.5",
    "pinia": "^3.0.4",
    "sonda": "^0.7.1",
    "typescript": "^5.9.2",
    "unplugin-auto-import": "^0.17.8",
    "unplugin-vue-components": "^0.27.5",
    "uuid": "^10.0.0",
    "vite": "^8.0.8",
    "vite-plugin-html": "^3.2.2",
    "vue": "^3.5.32",
    "vue-draggable-plus": "^0.5.6",
    "vue-router": "^5.0.4",
    "vue-tsc": "^2.2.12"
  }
}
